# Supabase (público — seguro no browser)
NEXT_PUBLIC_SUPABASE_URL=https://vnpslhbjlrhfuqajeuqx.supabase.co
# Preferir publishable key (novo). Fallback: ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NUNCA expor no client / NUNCA commitar valores reais
# Usado apenas em scripts de migração e operações admin privilegiadas
SUPABASE_SERVICE_ROLE_KEY=

# Legado — remover após migração completa para Supabase Auth
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# SESSION_SECRET=
# GITHUB_TOKEN=

# Email (opcional — recuperação de password via Resend, se mantiveres)
# RESEND_API_KEY=
# EMAIL_FROM=Proimagem.pt <hello@proimagem.pt>
# ADMIN_EMAIL=hello@proimagem.pt
